# Copy to .env and fill in your keys. Never commit .env.

PORT=8787

# ── Chat LLM ──────────────────────────────────────────────────
# Provider: cerebras | groq | sambanova | gemini | ollama
LLM_PROVIDER=cerebras
LLM_MODEL=gpt-oss-120b
CEREBRAS_API_KEY=

# Alternative providers (set LLM_PROVIDER + matching key):
# GROQ_API_KEY=
# SAMBANOVA_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Paper search (Tavily, 1000 free queries/day) ──────────────
TAVILY_API_KEY=

# ── Embeddings for RAG (Gemini free tier) ─────────────────────
# Used only for corpus/paper embeddings, not chat.
LLM_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta
